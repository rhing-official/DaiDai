rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 2人のuserIdから、directMessages/friendRequests/friends間で共通して使う
    // 決定的なペアidを組み立てる（順序に依存しない）。Dartモデル側のidFor()と同じ規則。
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // 広場[groupId]でrequest.auth.uidが[permission]（GroupPermissionの定数、
    // lib/models/group_role.dart参照）を持つかどうか。長（ownerId）は常に
    // 全権限を持つ。それ以外はGroup.memberPermissions（ロールの権限・付与から
    // クライアントが再計算して非正規化した実効権限、2026-07-28追加）を見る。
    function hasGroupPermission(groupId, permission) {
      let group = get(/databases/$(database)/documents/groups/$(groupId)).data;
      return group.ownerId == request.auth.uid
        || permission in group.memberPermissions[request.auth.uid];
    }

    // 管理者クレーム（`grantFirstAdminOnce`が付与するCustom Claims）を
    // 持つかどうか（2026-08-12追加、管理画面の便り身だしなみ編集用）。
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // stickerPacks/{packId}の出品者（creatorId）が[userId]自身かどうか
    // （favoritePacksの自己お気に入り防止用、2026-08-29追加）。
    function isOwnStickerPack(packId, userId) {
      return get(/databases/$(database)/documents/stickerPacks/$(packId)).data.creatorId == userId;
    }

    // users/{userId}: 本人のみ作成・更新可能。ログイン済みなら誰でも参照可能
    // （Rhing ID検索・重複チェックのため一覧クエリを許可する）。便り
    // （officialAccountUid、Firebase Authの実アカウントを持たない）だけは
    // 例外的に管理者が更新できる（管理画面の身だしなみタブから。他人には
    // なりすませないよう対象をこのuidのみに限定して許可、2026-08-12追加）。
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == userId;
      // 蔵（icons/backgroundImages/statusMessages/nicknames）の保管上限を
      // サーバー側でも強制する（クライアント側の上限チェックの保険）。
      // フィールドが存在しない場合（古いスキーマのままの書き込みなど）はスキップし、
      // 無関係な更新まで巻き込んでpermission-deniedにならないようにする。
      // 上限値はlib/models/profile_material.dart・profile_card.dartの
      // kMaxIcons(5)/kMaxBackgroundImages(3)/kMaxStatusMessages(10)/
      // kMaxNicknames(10)/kMaxSnsLinks(5)/kMaxProfileCards(3)、
      // fcm_token_entry.dartのkMaxFcmTokens(10)と一致させること。
      allow update: if request.auth != null
        && (request.auth.uid == userId
            || (isAdmin() && userId == 'official-tayori'))
        && (!('icons' in request.resource.data) || request.resource.data.icons.size() <= 5)
        && (!('backgroundImages' in request.resource.data) || request.resource.data.backgroundImages.size() <= 3)
        && (!('statusMessages' in request.resource.data) || request.resource.data.statusMessages.size() <= 10)
        && (!('nicknames' in request.resource.data) || request.resource.data.nicknames.size() <= 10)
        && (!('snsLinks' in request.resource.data) || request.resource.data.snsLinks.size() <= 5)
        && (!('profileCards' in request.resource.data) || request.resource.data.profileCards.size() <= 3)
        && (!('fcmTokens' in request.resource.data) || request.resource.data.fcmTokens.size() <= 10);
      allow delete: if false;

      // users/{userId}/friends/{friendUserId}: 本人のみ読み取り可能。
      // 作成は、対応するfriendRequestsがaccepted済みの場合のみ。
      // 承認処理は承認する側の1クライアントが双方のfriendsドキュメントをまとめて書き込むため、
      // 「自分 or 相手」どちらのuidでも書き込めるようにしている（詳細はFriendRepository.respond参照）。
      // ニックネームは友達関係ではなく身だしなみ（users/{userId}のnicknames）側で管理するため、更新は不可。
      match /friends/{friendUserId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == friendUserId)
          && get(/databases/$(database)/documents/friendRequests/$(pairId(userId, friendUserId))).data.status == 'accepted';
        allow update: if false;
        // 絶縁（双方合意による友達関係の解消）の実行は、対応するdirectMessagesの
        // severanceRequestedByが立っていて、かつ削除操作者がその提案者本人では
        // ないこと（＝提案者ではない側＝同意した側が実行していること）を条件に
        // 許可する。「自分 or 相手」どちらのuidでも削除できるのは、実行するのは
        // 同意した側の1クライアントが双方のfriendsドキュメントをまとめて
        // 削除するため（DirectMessageRepository.acceptSeverance参照）。
        allow delete: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == friendUserId)
          && get(/databases/$(database)/documents/directMessages/$(pairId(userId, friendUserId))).data.severanceRequestedBy != null
          && get(/databases/$(database)/documents/directMessages/$(pairId(userId, friendUserId))).data.severanceRequestedBy != request.auth.uid;
      }

      // users/{userId}/conversationPrefs/{conversationId}: 一対・広場のピン留め・通知オフなど、
      // 完全に個人的な表示設定。本人のみ読み書き可能（相手には一切公開しない）。
      match /conversationPrefs/{conversationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // users/{userId}/blockedUsers/{blockedUserId}: 一対でブロックした相手の一覧
      // （2026-07-25追加）。conversationPrefsと同じく完全に個人的な設定で、
      // 本人のみ読み書き可能（相手には一切公開しない。ブロックはサーバー側の
      // 送信拒否ではなく、クライアント側で相手のメッセージを表示しない・
      // 自分から送信できなくする形で実現する）。
      match /blockedUsers/{blockedUserId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // users/{userId}/ownedStickerPacks/{packId}: 所有しているペタピタ
      // パッケージ（技術仕様書7.4・7.5参照、2026-08-11追加）。付与はdaidai横丁
      // での購入完了時にCloud Function（Admin SDK、rulesを経由しない）が
      // 行う想定のため、クライアントからの書き込みは一切禁止する。フェーズ①
      // （アプリ内送受信のみの段階）ではFirebaseコンソールから直接投入して
      // 動作確認する。
      match /ownedStickerPacks/{packId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // users/{userId}/follows/{creatorId}: daidai横丁でフォローしている
      // クリエイターの一覧（存在＝フォロー中、2026-08-13追加）。集計値
      // （フォロワー数等）は持たないシンプルな設計のため、Cloud Functions
      // を介さずクライアントから本人のみ直接読み書きする。creatorId != userId
      // で自己フォローを禁止する（2026-08-29追加、クライアント側の防止に加え
      // Firestoreルール側でも強制）。
      match /follows/{creatorId} {
        allow read, write: if request.auth != null && request.auth.uid == userId
          && creatorId != userId;
      }

      // users/{userId}/favoritePacks/{packId}: daidai横丁でお気に入り登録
      // したパックの一覧（存在＝お気に入り、2026-08-13追加）。followsと同様、
      // 本人のみ直接読み書き可能。packIdはstickerPacks側のドキュメントIDのため、
      // 自己お気に入り防止にはisOwnStickerPack()でstickerPacksをget()して
      // creatorIdを参照する必要がある（作成時のみチェック、2026-08-29追加）。
      match /favoritePacks/{packId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
          && !isOwnStickerPack(packId, userId);
      }
    }

    // stickerPacks/{packId}: 頒布されているペタピタパッケージのカタログ
    // （技術仕様書7.4・7.5参照、2026-08-11追加）。daidai横丁
    // （HomePage-Rhing内のWebストア）が未ログインの一般訪問者にも
    // カタログを見せる必要があるため、認証不要で誰でも参照可能。
    // 投入・更新はFirebaseコンソール/Admin SDK・Cloud Functions経由のみで、
    // クライアントからの書き込みは禁止する。
    match /stickerPacks/{packId} {
      allow read: if true;
      allow write: if false;
    }

    // creatorProfiles/{userId}: daidai横丁で出品したことがあるユーザーの
    // 公開プロフィールミラー（呼び名・アイコン・ステメ・SNSリンクのみ、
    // 2026-08-13追加）。users/{userId}は未ログイン訪問者が読めないため、
    // Cloud Functions（syncCreatorProfile/createStickerPack、Admin SDK）が
    // 必要なフィールドだけを投影する。クライアントからの書き込みは禁止。
    match /creatorProfiles/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // stickerPackReports/{reportId}: daidai横丁のパック通報記録（v1は記録のみ、
    // 2026-08-11追加）。作成はcreateStickerPackReport callable（Admin SDK）
    // 経由のみで、Rhing運営がFirebase console等で手動レビューする想定のため
    // クライアントからの読み書きは一律禁止する。
    match /stickerPackReports/{reportId} {
      allow read, write: if false;
    }

    // userInvites/{rhingId}: 縁結び（個人の招待リンク）の公開プレビュー
    // （呼び名・アイコンのみ。友達一覧・語らいの内容は含まない）。招待リンクを
    // 開いた相手や、外部SNSのリンク展開（OGP）にも見せる必要があるため
    // 公開読み取り可能。書き込みは本人のみ（`userId`フィールドで判定）。
    // 便り（official-tayori）だけは、users/{userId}と同じ理由で管理者が
    // 代わりに書き込める（UserRepository.syncInvitePreviewは身だしなみ更新の
    // たびに呼ばれるため、ここに例外が無いとusers側の更新自体は成功しても
    // このプレビュー同期だけがpermission-deniedになる、2026-08-26発覚・修正）。
    match /userInvites/{rhingId} {
      allow read: if true;
      allow write: if request.auth != null
        && (request.auth.uid == request.resource.data.userId
            || (isAdmin() && request.resource.data.userId == 'official-tayori'));
    }

    // friendRequests/{requestId}: 友達申請。申請者・宛先本人のみ読み書き可能。
    // idはpairId()で決定的に組み立てられ、1組の相手につき常に1ドキュメントのみ存在する。
    match /friendRequests/{requestId} {
      // sendRequest()は送信前に存在確認のgetを行うため、
      // 未作成（resource == null）の場合は読み取りを許可する。
      allow read: if request.auth != null
        && (resource == null
            || request.auth.uid == resource.data.fromUserId
            || request.auth.uid == resource.data.toUserId);
      // 新規送信、または拒否後の再送信（宛先を問わず送信者本人のみ作成可能）。
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.status == 'pending'
        && requestId == pairId(request.resource.data.fromUserId, request.resource.data.toUserId);
      // 承認・拒否（宛先本人）、および相互申請時の即時承認。
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId)
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId;
      // 絶縁の実行時のみ削除を許可する（friendRequestsのidはdirectMessagesの
      // dmIdと同じpairId()で組み立てられているため、requestIdをそのまま
      // directMessagesのdocIdとして参照できる）。削除後は同じ相手に再度
      // 友達申請すれば新規ドキュメントとして作り直せる。
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId)
        && get(/databases/$(database)/documents/directMessages/$(requestId)).data.severanceRequestedBy != null
        && get(/databases/$(database)/documents/directMessages/$(requestId)).data.severanceRequestedBy != request.auth.uid;
    }

    // directMessages/{dmId}: 参加者本人のみ読み書き可能。
    match /directMessages/{dmId} {
      // getOrCreateDirectMessage()は作成前に存在確認のgetを行うため、
      // 未作成（resource == null）の場合は読み取りを許可する（中身は空なので問題ない）。
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participants);
      // 一対の作成は、対応するfriendRequestsがaccepted済みの場合のみ許可する
      // （仲間承認制のスパム対策。ID検索しただけでは会話を始められない）。
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && get(/databases/$(database)/documents/friendRequests/$(dmId)).data.status == 'accepted';
      // 通常の更新（lastMessageAt等）に加え、絶縁の提案・取り消し・辞退
      // （severanceRequestedByフィールドのみの変更）を許可する。ただし
      // このフィールドに設定できる値は「自分のuid」（提案）か「null」
      // （取り消し・辞退）のみに制限し、他人のuidを騙って「相手が同意した」
      // ことにして単独で絶縁を実行できてしまわないようにする。
      // 既読オン/オフの変更は双方合意制（2026-07-28追加）。提案・取り消し・
      // 辞退はreadReceiptsProposalByのみ変更し、readReceiptsEnabledは不変。
      // 承認は提案者以外が、提案中の値（現在の反転値）へreadReceiptsEnabled
      // を変更しつつreadReceiptsProposalByをクリアする場合のみ許可する。
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && (
          !('severanceRequestedBy' in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.severanceRequestedBy == request.auth.uid
          || request.resource.data.severanceRequestedBy == null
        )
        && (
          !(request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['readReceiptsProposalBy', 'readReceiptsEnabled']))
          || (
            request.resource.data.readReceiptsEnabled == resource.data.readReceiptsEnabled
            && (request.resource.data.readReceiptsProposalBy == request.auth.uid
                || request.resource.data.readReceiptsProposalBy == null)
          )
          || (
            resource.data.readReceiptsProposalBy != null
            && resource.data.readReceiptsProposalBy != request.auth.uid
            && request.resource.data.readReceiptsProposalBy == null
            && request.resource.data.readReceiptsEnabled == !resource.data.readReceiptsEnabled
          )
        )
        // 単一→複数モードへの切り替え（参加者ならどちらでも可。trueへの
        // 変更のみ許可し、逆方向は不可、2026-07-29追加）。
        && (
          !('roomsEnabled' in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.roomsEnabled == true
        );
      // 絶縁の実行（最終ステップ）。severanceRequestedByが立っていて、かつ
      // 削除操作者が提案者本人ではない（＝同意した側）場合のみ、この一対
      // 自体の削除を許可する。messages/friends/friendRequestsの削除も
      // 同じ条件をget()で参照するため、これらを全て消し終えてから最後に
      // 消す必要がある（DirectMessageRepository.acceptSeverance参照）。
      // アカウント削除通知後の削除（2026-07-28追加）: Cloud Functionsの
      // 定期処理がaccountDeletedUserIdをセットした後、もう一方の参加者が
      // 語らいを削除できる（DirectMessageRepository.deleteDmAfterAccountDeletion参照）。
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.participants
        && (
          (resource.data.severanceRequestedBy != null
            && resource.data.severanceRequestedBy != request.auth.uid)
          || (resource.data.accountDeletedUserId != null
            && resource.data.accountDeletedUserId != request.auth.uid)
        );

      // rooms/{roomId}: 寄合（テキストチャンネル、2026-07-28追加）。
      // 参加者を広場のRoom.memberIdsと同じ考え方でparticipantsとして
      // 非正規化して持つ（DM作成と同じバッチ内でこの寄合を作成する際、
      // 親directMessagesドキュメントをget()すると未コミット状態を見て
      // permission-deniedになるのを避けるため）。一対には長・モデレーターの
      // 概念が無いため、参加者2人はどちらも対等に作成・更新・削除できる。
      match /rooms/{roomId} {
        allow read: if request.auth != null
          && request.auth.uid in resource.data.participants;
        allow create: if request.auth != null
          && request.auth.uid in request.resource.data.participants;
        // name変更・lastMessageAt更新・寄合削除時のdeletionRequestedBy
        // マーカー設定を許可。
        allow update: if request.auth != null
          && request.auth.uid in resource.data.participants;
        allow delete: if request.auth != null
          && request.auth.uid in resource.data.participants;

        // メッセージは寄合の参加者のみ読み取り可能。
        // 送信は本人（senderId）かつ参加者である場合のみ許可。
        match /messages/{messageId} {
          allow read: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)/rooms/$(roomId)).data.participants;
          allow create: if request.auth != null
            && request.auth.uid == request.resource.data.senderId
            && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)/rooms/$(roomId)).data.participants;
          // 既読機能: 参加者本人がreadByフィールドのみを更新できる
          // （既読を付けるのに送信者である必要はない）。範囲選択削除
          // （2026-07-27追加）: 参加者本人がhiddenForに自分のuidだけを
          // 追加する更新も許可する（他人のuidを混ぜたり、既存のuidを
          // 消したりはできない）。
          // 編集・リアクション・送信取り消し時の引用プレビュー一括クリア
          // （2026-07-27追加、返信・編集・送信取り消し・リアクション機能）:
          //  - 編集: 本人の送信メッセージのcontent+editedAtのみ変更可
          //    （テキストメッセージのみ対応。DirectMessageRepository.editMessage参照）。
          //  - リアクション: reactionsマップのうち、自分（request.auth.uid）に
          //    対応するキーの追加・削除・値変更のみ許可する。値を設定する場合は
          //    空でないリストで、要素は全て固定絵文字セット（kReactionEmojis,
          //    lib/models/message.dart）のいずれかでなければならない
          //    （2026-08-05変更、以前は単一絵文字の文字列だったが、1人が
          //    複数の異なる絵文字を同時に持てるようリスト化した）。
          //  - 引用プレビューのクリア: 送信取り消し（unsendMessage）が、
          //    取り消したメッセージを引用返信している他のメッセージの
          //    replyTo系フィールドを消すために使う。参加者なら誰でも、この
          //    4フィールドを「クリアする方向」にのみ変更できる（値を設定する
          //    ことはできない＝なりすまし引用の捏造を防ぐ）。
          allow update: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)/rooms/$(roomId)).data.participants
            && (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
              || (
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor'])
                && request.resource.data.hiddenFor.hasAll('hiddenFor' in resource.data ? resource.data.hiddenFor : [])
                && request.resource.data.hiddenFor.removeAll('hiddenFor' in resource.data ? resource.data.hiddenFor : []).hasOnly([request.auth.uid])
              )
              || (
                request.auth.uid == resource.data.senderId
                && resource.data.contentType == 'text'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'editedAt'])
              )
              || (
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
                && ('reactions' in resource.data ? resource.data.reactions : {})
                     .diff(request.resource.data.reactions)
                     .affectedKeys()
                     .hasOnly([request.auth.uid])
                && (
                  !(request.auth.uid in request.resource.data.reactions)
                  || (
                    request.resource.data.reactions[request.auth.uid] is list
                    && request.resource.data.reactions[request.auth.uid].size() > 0
                    && request.resource.data.reactions[request.auth.uid].hasOnly(['👍', '❤️', '😂', '😮', '😢', '🙏'])
                  )
                )
              )
              || (
                request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['replyToMessageId', 'replyToSenderId', 'replyToSenderRhingId', 'replyToSnippet'])
                && !('replyToMessageId' in request.resource.data)
                && !('replyToSenderId' in request.resource.data)
                && !('replyToSenderRhingId' in request.resource.data)
                && !('replyToSnippet' in request.resource.data)
              )
              // アカウント削除通知への「いいえ」（2026-07-28追加）。以後
              // はい/いいえボタンを表示しないようにするだけの単純なフラグ。
              || (
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountDeletionResponse'])
                && request.resource.data.accountDeletionResponse == 'declined'
              )
            );
          // 絶縁の実行時（同意した側が実行）・アカウント削除通知後の削除・
          // 寄合単体の削除時（deletionRequestedByマーカー）・範囲選択削除で
          // 参加者全員がこのメッセージをhiddenForに含めた場合に加え、本人の
          // 送信メッセージはいつでも無条件で物理削除できる（送信取り消し、
          // 2026-07-27追加。相手側にも痕跡を残さず完全に消す仕様のため、
          // hiddenForのような論理フラグではなく物理削除にしている。
          // DirectMessageRepository.unsendMessage参照）。
          allow delete: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)/rooms/$(roomId)).data.participants
            && (
              (
                get(/databases/$(database)/documents/directMessages/$(dmId)).data.severanceRequestedBy != null
                && get(/databases/$(database)/documents/directMessages/$(dmId)).data.severanceRequestedBy != request.auth.uid
              )
              || (
                get(/databases/$(database)/documents/directMessages/$(dmId)).data.accountDeletedUserId != null
                && get(/databases/$(database)/documents/directMessages/$(dmId)).data.accountDeletedUserId != request.auth.uid
              )
              || get(/databases/$(database)/documents/directMessages/$(dmId)/rooms/$(roomId)).data.deletionRequestedBy != null
              || ('hiddenFor' in resource.data ? resource.data.hiddenFor : [])
                   .concat([request.auth.uid])
                   .hasAll(get(/databases/$(database)/documents/directMessages/$(dmId)/rooms/$(roomId)).data.participants)
              || resource.data.senderId == request.auth.uid
            );
        }

        // albums/{albumId}: 寄合単位の共有アルバム（2026-08-30追加）。個人の
        // フォトライブラリではなく、この寄合の参加者全員が対等に作成・登録・
        // 削除できる共有アルバム。manageRooms等の広場権限とは連動させず、
        // 単純に「この寄合の参加者かどうか」だけを見る。
        match /albums/{albumId} {
          allow read, delete: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)/rooms/$(roomId)).data.participants;
          allow create: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)/rooms/$(roomId)).data.participants
            && request.auth.uid == request.resource.data.createdBy;
          // リネーム、itemCount/cover*の非正規化更新（参加者なら誰でも）。
          allow update: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)/rooms/$(roomId)).data.participants;

          // items/{itemId}: アルバムに登録された画像・動画1件。編集機能は
          // 設けないためallow updateは無し（追加・削除のみ）。
          match /items/{itemId} {
            allow read, delete: if request.auth != null
              && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)/rooms/$(roomId)).data.participants;
            allow create: if request.auth != null
              && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)/rooms/$(roomId)).data.participants
              && request.auth.uid == request.resource.data.addedBy;
          }
        }

        // calendarEvents/{eventId}: 寄合単位の共有カレンダーの予定
        // （Googleカレンダー同期の元データ、2026-09-01追加）。albumsと同じく
        // この寄合の参加者全員が対等に作成・編集・削除できる。
        match /calendarEvents/{eventId} {
          allow read, delete: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)/rooms/$(roomId)).data.participants;
          allow create: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)/rooms/$(roomId)).data.participants
            && request.auth.uid == request.resource.data.createdBy;
          allow update: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)/rooms/$(roomId)).data.participants;

          // syncStates/{uid}: 「自分がこの予定をGoogle側へ同期したか」の
          // 個人ごとの状態。
          match /syncStates/{uid} {
            // get（詳細画面での自分の同期状態購読）はドキュメントパスの
            // uidだけで判定できる。list（CalendarSyncWorkerのcollectionGroup
            // クエリ）はFirestoreがクエリ定義だけから安全性を静的に証明する
            // 必要があるため、クライアント側のwhere('uid', isEqualTo: ...)と
            // 対応するresource.data.uidで判定する（パスのuidでは証明できず
            // permission-deniedになる、2026-07-29に発覚した既存の教訓と同種の罠）。
            allow get: if request.auth != null && request.auth.uid == uid;
            allow list: if request.auth != null
              && request.auth.uid == resource.data.uid;
            // 書き込みは寄合の参加者なら誰でも可（本人のuidのみに限定して
            // いたところ、予定作成者が参加者全員分のsyncStatesを一括初期化
            // する既存のバッチ書き込みと矛盾し、常にpermission-deniedで
            // 失敗していた。2026-09-01発覚・修正。他人のsyncStatesを書き
            // 換えられても実害は「その人の同期が行われない」程度で、
            // Googleの認証情報等の機密性には影響しない）。
            allow write: if request.auth != null
              && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)/rooms/$(roomId)).data.participants;
          }
        }
      }
    }

    // groups/{groupId}: 広場。メンバーのみ読み取り可能。
    // 作成時: 作成者がownerかつメンバーに含まれていること。
    // 権限モデル（2026-07-28更新）: 「モデレーター」は廃止し、長（ownerId、
    // 常に全権限）とカスタムロール（GroupPermissionの権限を持つ、複数付与可）に
    // 統合した。実際の権限はGroup.memberPermissions（クライアントが
    // ロール定義・付与から再計算して非正規化した実効権限）を根拠にする。
    // 更新（2026-07-24追加、広場のカスタマイズ機能）は以下のパターンのみ許可する:
    //  (1) プロフィールカードの編集: メンバー全員が可能。profileCard/nameのみ変更。
    //  (2) 他メンバーを含むmemberIds/memberRolesの書き換え（強制退会等）: 長のみ。
    //  (3) 参加リクエストの承認によるメンバー追加: manageJoinRequests権限を持つ
    //      メンバーのみ、既存メンバーを除去しない変更のみ。承認の可否自体は
    //      joinRequests側で統制する。
    //  (4) 本人の退会: 自分自身をmemberIds/memberRoles/roleAssignments/
    //      memberPermissionsから除く変更のみ、本人が実行可能
    //      （オーナーは対象外＝退会不可）。
    //  (5) 既読機能のオン/オフ: manageReadReceipts権限を持つメンバーのみ。
    //  (6) ロールの付与・優先順位: manageRoles権限を持つメンバーのみ。
    //  (7) memberPermissionsの再計算書き込み: manageRoles/manageJoinRequests
    //      権限を持つメンバーのみ（クライアント計算結果をそのまま信頼する）。
    //  (8) 長の譲渡: 現オーナーのみ、新オーナーは既存メンバーであること。
    match /groups/{groupId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && (
          // プロフィールカードの編集（メンバー全員可能）。カード名は広場名と
          // 同一の値として扱うため、nameも同時に変更できるようにする
          // （2026-07-25、カード編集画面から広場名も変更できるようにした変更）。
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profileCard', 'name'])
          // 他メンバーを含むmemberIds/memberRolesの書き換え（強制退会等）は
          // 長のみ（2026-07-28、「モデレーター」概念の廃止に伴いownerId基準に
          // 変更。対応する強制退会UI機能は現状無い）。
          || (
            request.auth.uid == resource.data.ownerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberRoles'])
          )
          // 参加リクエストの承認によるメンバー追加（長、またはmanageJoinRequests
          // 権限を持つロールの付与者のみ。既存メンバーを除去する変更は不可、
          // 2026-07-28更新）。
          || (
            (request.auth.uid == resource.data.ownerId
              || 'manageJoinRequests' in resource.data.memberPermissions[request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberRoles'])
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          )
          // 自分自身の退会（memberIds/memberRolesに加え、自分のロール付与・
          // 実効権限キャッシュも同じ書き込みでクリアする、2026-07-28更新）。
          || (
            request.auth.uid != resource.data.ownerId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['memberIds', 'memberRoles', 'roleAssignments', 'memberPermissions'])
            && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
          )
          // 既読機能のオン/オフ（長、またはmanageReadReceipts権限を持つ
          // ロールの付与者のみ変更可、2026-07-28更新）。
          || (
            (request.auth.uid == resource.data.ownerId
              || 'manageReadReceipts' in resource.data.memberPermissions[request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readReceiptsEnabled'])
          )
          // カスタムロールの付与・優先順位の変更（長、またはmanageRoles権限を
          // 持つロールの付与者のみ、2026-07-28更新）。
          || (
            (request.auth.uid == resource.data.ownerId
              || 'manageRoles' in resource.data.memberPermissions[request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['roleAssignments', 'rolePriority'])
          )
          // 実効権限キャッシュ（memberPermissions）の再計算書き込み。
          // ロール変更（manageRoles）・参加承認（manageJoinRequests）いずれの
          // 後にも呼ばれるため両方を許可する（firestore.rulesはロール
          // ドキュメントを跨いだ動的な権限計算ができないため、クライアントが
          // 計算した結果をそのまま信頼する設計。2026-07-28追加）。
          || (
            (request.auth.uid == resource.data.ownerId
              || 'manageRoles' in resource.data.memberPermissions[request.auth.uid]
              || 'manageJoinRequests' in resource.data.memberPermissions[request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberPermissions'])
          )
          // 長の譲渡（現オーナーのみ、新オーナーは既存メンバーであること、2026-07-28追加）。
          || (
            request.auth.uid == resource.data.ownerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId'])
            && request.resource.data.ownerId in resource.data.memberIds
          )
          // 単一↔複数モードの切り替え（長、またはmanageRooms権限を持つ
          // ロールの付与者のみ）。単一に戻す方向（false）は寄合が1つだけの
          // 場合に限りクライアント（GroupRepository.setRoomsEnabled）側で
          // 制限する。firestore.rulesはサブコレクションの件数を検証できない
          // ため、memberPermissionsキャッシュと同じく計算結果をクライアント
          // から信頼する設計（2026-07-29変更、以前はtrueへの変更のみ許可）。
          || (
            (request.auth.uid == resource.data.ownerId
              || 'manageRooms' in resource.data.memberPermissions[request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roomsEnabled'])
          )
          // メッセージ送信時のlastMessageAt/lastMessageSenderIdの非正規化更新
          // （語らい一覧の並べ替え用、2026-09-02追加）。メンバー全員が対等に
          // 更新可能（GroupRepository.sendRoomMessage等参照）。
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'lastMessageSenderId'])
        );
      // 広場自体の削除は長のみ（2026-08-02追加、GroupRepository.deleteGroup
      // 参照）。事前にサブコレクション（rooms/messages/roles）を全て物理削除
      // してから呼ぶことをクライアント側で保証する（このルール単体では
      // サブコレクションの削除順序までは検証できない）。
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;

      // joinRequests/{requesterId}: 招待リンクからの参加リクエスト。
      // ドキュメントidは申請者本人のuserId（1人につき常に1件）。
      match /joinRequests/{requesterId} {
        allow read: if request.auth != null
          && (request.auth.uid == requesterId
              || hasGroupPermission(groupId, 'manageJoinRequests'));
        allow create: if request.auth != null
          && request.auth.uid == requesterId
          && request.resource.data.requesterId == requesterId
          && request.resource.data.groupId == groupId
          && request.resource.data.status == 'pending';
        // 承認・却下はmanageJoinRequests権限を持つメンバーのみ。id・申請者情報は
        // 不変。却下後の再申請（GroupRepository.requestToJoinは同じドキュメントを
        // 使い回す設計）は申請者本人にも許可する。ただしstatusをpendingに
        // 戻すことしかできず、自分でacceptedにする等はできない
        // （却下後に再申請してもpermission-deniedになっていた不具合の修正）。
        allow update: if request.auth != null
          && request.resource.data.requesterId == resource.data.requesterId
          && request.resource.data.groupId == resource.data.groupId
          && (
            hasGroupPermission(groupId, 'manageJoinRequests')
            || (
              request.auth.uid == requesterId
              && resource.data.status != 'pending'
              && request.resource.data.status == 'pending'
            )
          );
        allow delete: if false;
      }

      // roles/{roleId}: カスタムロール（名前・色・権限を持つ、2026-07-28更新）。
      // 作成・編集・削除はmanageRoles権限を持つメンバーのみ、閲覧はメンバー全員
      // （呼び名の色付け・権限判定にメンバー全員のクライアントが必要なため）。
      // 基準ロール（isEveryone）の初回作成はオーナーのみ許可する
      // （GroupRepository.createGroup）。以前は「通常の作成では常にfalseを
      // 強制し、isEveryoneはGroupRepository内部でのみ作成する」という
      // コメント付きの制限だったが、Firestoreルールは呼び出し元のコード
      // パスを区別できないため、この制限は広場作成時の基準ロール作成自体を
      // 常に拒否してしまう不具合だった（2026-08-13発覚・修正。既存広場は
      // 一度きりのCloud Function移行＝Admin SDK経由でルールを迂回して
      // 基準ロールを作成済みだったため、この不具合はこれまで新規広場作成時
      // にしか顕在化していなかった）。
      match /roles/{roleId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow create: if request.auth != null
          && request.resource.data.groupId == groupId
          && (
            (hasGroupPermission(groupId, 'manageRoles') && request.resource.data.isEveryone == false)
            || (
              request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId
              && request.resource.data.isEveryone == true
            )
          );
        allow update: if request.auth != null
          && hasGroupPermission(groupId, 'manageRoles');
        allow delete: if request.auth != null
          && hasGroupPermission(groupId, 'manageRoles');
      }

      // rooms/{roomId}: 寄合。memberIdsを広場から非正規化して持つ
      // （メッセージ読み取りルールがgroupsドキュメントを跨いで参照しなくて済むように）。
      // 寄合の作成・削除はmanageRooms権限を持つメンバーのみ（2026-07-28、
      // 複数寄合対応で追加。それまではメンバーなら誰でも作成でき削除は
      // 常に不可という未整備な状態だった）。
      match /rooms/{roomId} {
        allow read: if request.auth != null
          && request.auth.uid in resource.data.memberIds;
        allow create: if request.auth != null
          && hasGroupPermission(groupId, 'manageRooms')
          && request.auth.uid in request.resource.data.memberIds;
        // memberIdsのみの変更（参加承認・退会同期）は全メンバー可。
        // それ以外（name変更・寄合削除時のroomDeletionRequestedByマーカー・
        // rolePriorityOverride設定・customSettingsEnabled切替等）は
        // manageRooms権限を持つメンバーのみ。ただしreadReceiptsEnabledOverride
        // （寄合ごとの既読オン/オフ上書き、2026-07-29追加）だけは、広場全体の
        // 既読オン/オフと同じmanageReadReceipts権限で変更できるようにする
        // （UI側のゲート`canManageReadReceipts`と一致させるため）。
        // pinnedMessageIds（メッセージのピン留め、2026-08-30追加）は権限
        // チェック無しで全メンバーに許可する（ユーザー判断、リアクションと
        // 同様に誰でも触れる軽量な操作として扱う）。
        allow update: if request.auth != null
          && request.auth.uid in resource.data.memberIds
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            || hasGroupPermission(groupId, 'manageRooms')
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readReceiptsEnabledOverride'])
              && hasGroupPermission(groupId, 'manageReadReceipts')
            )
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinnedMessageIds'])
          );
        allow delete: if request.auth != null
          && hasGroupPermission(groupId, 'manageRooms');

        match /messages/{messageId} {
          allow read: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)/rooms/$(roomId)).data.memberIds;
          allow create: if request.auth != null
            && request.auth.uid == request.resource.data.senderId
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)/rooms/$(roomId)).data.memberIds;
          // 既読機能: メンバー本人がreadByフィールドのみを更新できる。
          // 範囲選択削除（2026-07-27追加）: メンバー本人がhiddenForに
          // 自分のuidだけを追加する更新も許可する（一対のmessagesと同じ設計、
          // firestore.rulesのdirectMessages/{dmId}/messages参照）。
          // 編集・リアクション・引用プレビュー一括クリア（2026-07-27追加、
          // 返信・編集・送信取り消し・リアクション機能）は一対側と全く同じ
          // 設計（directMessages/{dmId}/messagesのコメント参照）。
          allow update: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)/rooms/$(roomId)).data.memberIds
            && (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
              || (
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor'])
                && request.resource.data.hiddenFor.hasAll('hiddenFor' in resource.data ? resource.data.hiddenFor : [])
                && request.resource.data.hiddenFor.removeAll('hiddenFor' in resource.data ? resource.data.hiddenFor : []).hasOnly([request.auth.uid])
              )
              || (
                request.auth.uid == resource.data.senderId
                && resource.data.contentType == 'text'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'editedAt'])
              )
              || (
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
                && ('reactions' in resource.data ? resource.data.reactions : {})
                     .diff(request.resource.data.reactions)
                     .affectedKeys()
                     .hasOnly([request.auth.uid])
                && (
                  !(request.auth.uid in request.resource.data.reactions)
                  || (
                    request.resource.data.reactions[request.auth.uid] is list
                    && request.resource.data.reactions[request.auth.uid].size() > 0
                    && request.resource.data.reactions[request.auth.uid].hasOnly(['👍', '❤️', '😂', '😮', '😢', '🙏'])
                  )
                )
              )
              || (
                request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['replyToMessageId', 'replyToSenderId', 'replyToSenderRhingId', 'replyToSnippet'])
                && !('replyToMessageId' in request.resource.data)
                && !('replyToSenderId' in request.resource.data)
                && !('replyToSenderRhingId' in request.resource.data)
                && !('replyToSnippet' in request.resource.data)
              )
            );
          // 範囲選択削除でメンバー全員がこのメッセージをhiddenForに含めた
          // 場合・寄合単体の削除時（roomDeletionRequestedByマーカー、
          // 2026-07-28追加）に加え、本人の送信メッセージはいつでも無条件で
          // 物理削除できる（送信取り消し、2026-07-27追加。
          // GroupRepository.unsendRoomMessage参照）。
          allow delete: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)/rooms/$(roomId)).data.memberIds
            && (
              ('hiddenFor' in resource.data ? resource.data.hiddenFor : [])
                   .concat([request.auth.uid])
                   .hasAll(get(/databases/$(database)/documents/groups/$(groupId)/rooms/$(roomId)).data.memberIds)
              || resource.data.senderId == request.auth.uid
              || get(/databases/$(database)/documents/groups/$(groupId)/rooms/$(roomId)).data.roomDeletionRequestedBy != null
            );
        }

        // albums/{albumId}: 寄合単位の共有アルバム（2026-08-30追加）。
        // 一対側（directMessages/{dmId}/rooms/{roomId}/albums）と同じ設計。
        // manageRooms等の広場権限とは連動させず、単純に寄合のメンバーで
        // あるかどうかだけを見る（要件通り、全メンバーが対等）。
        match /albums/{albumId} {
          allow read, delete: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)/rooms/$(roomId)).data.memberIds;
          allow create: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)/rooms/$(roomId)).data.memberIds
            && request.auth.uid == request.resource.data.createdBy;
          allow update: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)/rooms/$(roomId)).data.memberIds;

          match /items/{itemId} {
            allow read, delete: if request.auth != null
              && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)/rooms/$(roomId)).data.memberIds;
            allow create: if request.auth != null
              && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)/rooms/$(roomId)).data.memberIds
              && request.auth.uid == request.resource.data.addedBy;
          }
        }

        // calendarEvents/{eventId}: 寄合単位の共有カレンダーの予定
        // （Googleカレンダー同期の元データ、2026-09-01追加）。
        // 一対側（directMessages/{dmId}/rooms/{roomId}/calendarEvents）と同じ設計。
        match /calendarEvents/{eventId} {
          allow read, delete: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)/rooms/$(roomId)).data.memberIds;
          allow create: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)/rooms/$(roomId)).data.memberIds
            && request.auth.uid == request.resource.data.createdBy;
          allow update: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)/rooms/$(roomId)).data.memberIds;

          match /syncStates/{uid} {
            // get（詳細画面での自分の同期状態購読）はドキュメントパスの
            // uidだけで判定できる。list（CalendarSyncWorkerのcollectionGroup
            // クエリ）はFirestoreがクエリ定義だけから安全性を静的に証明する
            // 必要があるため、クライアント側のwhere('uid', isEqualTo: ...)と
            // 対応するresource.data.uidで判定する（パスのuidでは証明できず
            // permission-deniedになる、2026-07-29に発覚した既存の教訓と同種の罠）。
            allow get: if request.auth != null && request.auth.uid == uid;
            allow list: if request.auth != null
              && request.auth.uid == resource.data.uid;
            // 書き込みは寄合のメンバーなら誰でも可（本人のuidのみに限定して
            // いたところ、予定作成者が参加者全員分のsyncStatesを一括初期化
            // する既存のバッチ書き込みと矛盾し、常にpermission-deniedで
            // 失敗していた。2026-09-01発覚・修正。他人のsyncStatesを書き
            // 換えられても実害は「その人の同期が行われない」程度で、
            // Googleの認証情報等の機密性には影響しない）。
            allow write: if request.auth != null
              && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)/rooms/$(roomId)).data.memberIds;
          }
        }
      }
    }

    // groupInvites/{groupId}: 広場の招待プレビュー（名前・アイコン・説明のみ）。
    // 招待リンクを開いた非メンバーや、外部SNSのリンク展開（OGP）にも見せる必要が
    // あるため公開読み取り可能。メンバー一覧・メッセージ等の非公開情報は含まない。
    // 書き込みは対応する広場のメンバーのみ（プロフィールカード編集・広場作成時に
    // groups/{groupId}と同時に更新する）。
    match /groupInvites/{groupId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // qrLoginSessions/{sessionId}: QRコードログイン（2026-08-09追加）。未ログイン
    // 端末が作成し、ログイン済みの別端末が承認するまでの一時的なセッション。
    // 未ログイン端末が自身のステータス変化を監視できるよう公開読み取り可能
    // （sessionIdはFirestore自動生成IDで推測不可なため、userInvites/groupInvitesと
    // 同じ「知っていれば読める」設計）。承認（approvedUid付与）・claim・カスタム
    // トークン発行は全てCloud Functions（Admin SDK、ルール適用外）経由で行うため、
    // クライアントからのupdate/deleteは一切許可しない。
    match /qrLoginSessions/{sessionId} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['status', 'createdAt'])
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // calls/{callId}: 音声通話（フェーズ1、一対限定）。発信者・着信者本人のみ読み書き可能。
    // シグナリング（offer/answer/status）はどちらの当事者からも更新できる必要があるため、
    // フィールド単位の制限はせず当事者判定のみで許可する。
    match /calls/{callId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.callerId
            || request.auth.uid == resource.data.calleeId);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.callerId;
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.callerId
            || request.auth.uid == resource.data.calleeId);
      allow delete: if false;

      // ICE candidateのやり取り用サブコレクション。当事者のみ読み書き可能。
      match /{candidateCollection}/{candidateId} {
        allow read, create: if request.auth != null
          && candidateCollection in ['callerCandidates', 'calleeCandidates']
          && (request.auth.uid ==
                get(/databases/$(database)/documents/calls/$(callId)).data.callerId
              || request.auth.uid ==
                get(/databases/$(database)/documents/calls/$(callId)).data.calleeId);
        allow update: if false;
        allow delete: if false;
      }
    }

    // groupCalls/{groupCallId}: 広場（グループ）通話（2026-07-24追加）。
    // メッシュ型P2Pのため、参加者のペアごとに独立したシグナリング
    // （peerLinks/{pairId}＋candidatesA/candidatesB）を持つ。
    // memberIdsは通話開始時点の広場メンバーを非正規化して保持し
    // （groups/rooms/groupInvitesと同じ考え方）、通話ドキュメント自体は
    // 作成後にmemberIds/groupId/initiatorIdを変更できないようにする。
    match /groupCalls/{groupCallId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.initiatorId
        && request.auth.uid in request.resource.data.memberIds;
      // status/endedAtの更新（終了処理）のみ許可。memberIds等は不変。
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.initiatorId == resource.data.initiatorId;
      allow delete: if false;

      // participants/{userId}: 通話への入退室は本人のみ。一覧は通話開始時点の
      // メンバーなら読み取り可能。
      match /participants/{userId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groupCalls/$(groupCallId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.auth.uid in get(/databases/$(database)/documents/groupCalls/$(groupCallId)).data.memberIds;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // peerLinks/{pairId}: 参加者2人ぶんのペア単位のシグナリング。
      // pairId・userAId・userBIdはCallPeerLink.idFor()と同じ規則
      // （辞書順で小さい方がuserA＝オファー役）で組み立てる。
      match /peerLinks/{pairId} {
        allow read: if request.auth != null
          && (resource == null
              || request.auth.uid == resource.data.userAId
              || request.auth.uid == resource.data.userBId);
        allow create: if request.auth != null
          && (request.auth.uid == request.resource.data.userAId
              || request.auth.uid == request.resource.data.userBId);
        allow update: if request.auth != null
          && (request.auth.uid == resource.data.userAId
              || request.auth.uid == resource.data.userBId)
          && request.resource.data.userAId == resource.data.userAId
          && request.resource.data.userBId == resource.data.userBId;
        allow delete: if false;

        // ICE candidateのやり取り用サブコレクション。当事者2人のみ読み書き可能
        // （calls/{callId}のcallerCandidates/calleeCandidatesと同じ考え方）。
        match /{candidateCollection}/{candidateId} {
          allow read, create: if request.auth != null
            && candidateCollection in ['candidatesA', 'candidatesB']
            && (request.auth.uid ==
                  get(/databases/$(database)/documents/groupCalls/$(groupCallId)/peerLinks/$(pairId)).data.userAId
                || request.auth.uid ==
                  get(/databases/$(database)/documents/groupCalls/$(groupCallId)/peerLinks/$(pairId)).data.userBId);
          allow update: if false;
          allow delete: if false;
        }
      }
    }

    // groupActiveCallPointers/{groupId}: 広場ごとに1件だけ存在する、
    // 「現在アクティブな通話id」を指す軽量なポインタ（2026-07-26追加）。
    // 複数のメンバーがほぼ同時に通話開始ボタンを押しても全員が同じ通話に
    // 入れるよう、GroupCallRepository.getOrCreateActiveGroupCallが
    // Firestoreのトランザクションでこのドキュメントを読み書きして
    // 「無ければ作る」を原子的に行うために使う
    // （lib/repositories/group_call_repository.dart参照）。
    // 中身はactiveCallId（文字列またはnull）のみで機微な情報を含まない。
    match /groupActiveCallPointers/{groupId} {
      allow read, create, update: if request.auth != null
        && request.auth.uid in
          get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      allow delete: if false;
    }
  }
}
