rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 2人のuserIdから、directMessages/friendRequests/friends間で共通して使う
    // 決定的なペアidを組み立てる（順序に依存しない）。Dartモデル側のidFor()と同じ規則。
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // users/{userId}: 本人のみ作成・更新可能。ログイン済みなら誰でも参照可能
    // （Rhing ID検索・重複チェックのため一覧クエリを許可する）。
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == userId;
      // 蔵（icons/backgroundImages/statusMessages/nicknames）の保管上限を
      // サーバー側でも強制する（クライアント側の上限チェックの保険）。
      // フィールドが存在しない場合（古いスキーマのままの書き込みなど）はスキップし、
      // 無関係な更新まで巻き込んでpermission-deniedにならないようにする。
      allow update: if request.auth != null && request.auth.uid == userId
        && (!('icons' in request.resource.data) || request.resource.data.icons.size() <= 2)
        && (!('backgroundImages' in request.resource.data) || request.resource.data.backgroundImages.size() <= 3)
        && (!('statusMessages' in request.resource.data) || request.resource.data.statusMessages.size() <= 2)
        && (!('nicknames' in request.resource.data) || request.resource.data.nicknames.size() <= 3)
        && (!('snsLinks' in request.resource.data) || request.resource.data.snsLinks.size() <= 5)
        && (!('profileCards' in request.resource.data) || request.resource.data.profileCards.size() <= 3);
      allow delete: if false;

      // users/{userId}/friends/{friendUserId}: 本人のみ読み取り可能。
      // 作成は、対応するfriendRequestsがaccepted済みの場合のみ。
      // 承認処理は承認する側の1クライアントが双方のfriendsドキュメントをまとめて書き込むため、
      // 「自分 or 相手」どちらのuidでも書き込めるようにしている（詳細はFriendRepository.respond参照）。
      // ニックネームは友達関係ではなく身だしなみ（users/{userId}のnicknames）側で管理するため、更新は不可。
      match /friends/{friendUserId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == friendUserId)
          && get(/databases/$(database)/documents/friendRequests/$(pairId(userId, friendUserId))).data.status == 'accepted';
        allow update: if false;
        allow delete: if false;
      }

      // users/{userId}/conversationPrefs/{conversationId}: 一対・広場のピン留め・通知オフなど、
      // 完全に個人的な表示設定。本人のみ読み書き可能（相手には一切公開しない）。
      match /conversationPrefs/{conversationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // users/{userId}/blockedUsers/{blockedUserId}: 一対でブロックした相手の一覧
      // （2026-07-25追加）。conversationPrefsと同じく完全に個人的な設定で、
      // 本人のみ読み書き可能（相手には一切公開しない。ブロックはサーバー側の
      // 送信拒否ではなく、クライアント側で相手のメッセージを表示しない・
      // 自分から送信できなくする形で実現する）。
      match /blockedUsers/{blockedUserId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // userInvites/{rhingId}: 縁結び（個人の招待リンク）の公開プレビュー
    // （呼び名・アイコンのみ。友達一覧・語らいの内容は含まない）。招待リンクを
    // 開いた相手や、外部SNSのリンク展開（OGP）にも見せる必要があるため
    // 公開読み取り可能。書き込みは本人のみ（`userId`フィールドで判定）。
    match /userInvites/{rhingId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    // friendRequests/{requestId}: 友達申請。申請者・宛先本人のみ読み書き可能。
    // idはpairId()で決定的に組み立てられ、1組の相手につき常に1ドキュメントのみ存在する。
    match /friendRequests/{requestId} {
      // sendRequest()は送信前に存在確認のgetを行うため、
      // 未作成（resource == null）の場合は読み取りを許可する。
      allow read: if request.auth != null
        && (resource == null
            || request.auth.uid == resource.data.fromUserId
            || request.auth.uid == resource.data.toUserId);
      // 新規送信、または拒否後の再送信（宛先を問わず送信者本人のみ作成可能）。
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.status == 'pending'
        && requestId == pairId(request.resource.data.fromUserId, request.resource.data.toUserId);
      // 承認・拒否（宛先本人）、および相互申請時の即時承認。
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId)
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId;
      allow delete: if false;
    }

    // directMessages/{dmId}: 参加者本人のみ読み書き可能。
    match /directMessages/{dmId} {
      // getOrCreateDirectMessage()は作成前に存在確認のgetを行うため、
      // 未作成（resource == null）の場合は読み取りを許可する（中身は空なので問題ない）。
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participants);
      // 一対の作成は、対応するfriendRequestsがaccepted済みの場合のみ許可する
      // （仲間承認制のスパム対策。ID検索しただけでは会話を始められない）。
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && get(/databases/$(database)/documents/friendRequests/$(dmId)).data.status == 'accepted';
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow delete: if false;

      // メッセージは縁側の参加者のみ読み取り可能。
      // 送信は本人（senderId）かつ参加者である場合のみ許可。
      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)).data.participants;
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.senderId
          && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)).data.participants;
        allow update: if false;
        allow delete: if false;
      }
    }

    // groups/{groupId}: 広場。メンバーのみ読み取り可能。
    // 作成時: 作成者がownerかつメンバーに含まれていること。
    // 更新（2026-07-24追加、広場のカスタマイズ機能）は以下の3パターンのみ許可する:
    //  (1) プロフィールカードの編集: メンバー全員が可能。profileCardフィールドのみ変更。
    //  (2) 参加リクエストの承認によるメンバー追加: 長・モデレーターのみ、
    //      memberIds/memberRolesのみ変更。承認の可否自体はjoinRequests側で統制する。
    //  (3) 本人の退会: 自分自身をmemberIds/memberRolesから除く変更のみ、
    //      本人が実行可能（オーナーは対象外＝退会不可）。
    match /groups/{groupId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && (
          // プロフィールカードの編集（メンバー全員可能）。カード名は広場名と
          // 同一の値として扱うため、nameも同時に変更できるようにする
          // （2026-07-25、カード編集画面から広場名も変更できるようにした変更）。
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profileCard', 'name'])
          || (
            resource.data.memberRoles[request.auth.uid] in ['owner', 'moderator']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberRoles'])
          )
          || (
            request.auth.uid != resource.data.ownerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberRoles'])
            && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
          )
        );
      allow delete: if false;

      // joinRequests/{requesterId}: 招待リンクからの参加リクエスト。
      // ドキュメントidは申請者本人のuserId（1人につき常に1件）。
      match /joinRequests/{requesterId} {
        allow read: if request.auth != null
          && (request.auth.uid == requesterId
              || get(/databases/$(database)/documents/groups/$(groupId)).data.memberRoles[request.auth.uid] in ['owner', 'moderator']);
        allow create: if request.auth != null
          && request.auth.uid == requesterId
          && request.resource.data.requesterId == requesterId
          && request.resource.data.groupId == groupId
          && request.resource.data.status == 'pending';
        // 承認・却下は長・モデレーターのみ。id・申請者情報は不変。
        allow update: if request.auth != null
          && get(/databases/$(database)/documents/groups/$(groupId)).data.memberRoles[request.auth.uid] in ['owner', 'moderator']
          && request.resource.data.requesterId == resource.data.requesterId
          && request.resource.data.groupId == resource.data.groupId;
        allow delete: if false;
      }

      // rooms/{roomId}: お部屋。memberIdsを広場から非正規化して持つ
      // （メッセージ読み取りルールがgroupsドキュメントを跨いで参照しなくて済むように）。
      match /rooms/{roomId} {
        allow read: if request.auth != null
          && request.auth.uid in resource.data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in request.resource.data.memberIds;
        // 送信時のlastMessageAt更新、参加承認・退会によるmemberIds更新を許可。
        allow update: if request.auth != null
          && request.auth.uid in resource.data.memberIds;
        allow delete: if false;

        match /messages/{messageId} {
          allow read: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)/rooms/$(roomId)).data.memberIds;
          allow create: if request.auth != null
            && request.auth.uid == request.resource.data.senderId
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)/rooms/$(roomId)).data.memberIds;
          allow update: if false;
          allow delete: if false;
        }
      }
    }

    // groupInvites/{groupId}: 広場の招待プレビュー（名前・アイコン・説明のみ）。
    // 招待リンクを開いた非メンバーや、外部SNSのリンク展開（OGP）にも見せる必要が
    // あるため公開読み取り可能。メンバー一覧・メッセージ等の非公開情報は含まない。
    // 書き込みは対応する広場のメンバーのみ（プロフィールカード編集・広場作成時に
    // groups/{groupId}と同時に更新する）。
    match /groupInvites/{groupId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // calls/{callId}: 音声通話（フェーズ1、一対限定）。発信者・着信者本人のみ読み書き可能。
    // シグナリング（offer/answer/status）はどちらの当事者からも更新できる必要があるため、
    // フィールド単位の制限はせず当事者判定のみで許可する。
    match /calls/{callId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.callerId
            || request.auth.uid == resource.data.calleeId);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.callerId;
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.callerId
            || request.auth.uid == resource.data.calleeId);
      allow delete: if false;

      // ICE candidateのやり取り用サブコレクション。当事者のみ読み書き可能。
      match /{candidateCollection}/{candidateId} {
        allow read, create: if request.auth != null
          && candidateCollection in ['callerCandidates', 'calleeCandidates']
          && (request.auth.uid ==
                get(/databases/$(database)/documents/calls/$(callId)).data.callerId
              || request.auth.uid ==
                get(/databases/$(database)/documents/calls/$(callId)).data.calleeId);
        allow update: if false;
        allow delete: if false;
      }
    }

    // groupCalls/{groupCallId}: 広場（グループ）通話（2026-07-24追加）。
    // メッシュ型P2Pのため、参加者のペアごとに独立したシグナリング
    // （peerLinks/{pairId}＋candidatesA/candidatesB）を持つ。
    // memberIdsは通話開始時点の広場メンバーを非正規化して保持し
    // （groups/rooms/groupInvitesと同じ考え方）、通話ドキュメント自体は
    // 作成後にmemberIds/groupId/initiatorIdを変更できないようにする。
    match /groupCalls/{groupCallId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.initiatorId
        && request.auth.uid in request.resource.data.memberIds;
      // status/endedAtの更新（終了処理）のみ許可。memberIds等は不変。
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.initiatorId == resource.data.initiatorId;
      allow delete: if false;

      // participants/{userId}: 通話への入退室は本人のみ。一覧は通話開始時点の
      // メンバーなら読み取り可能。
      match /participants/{userId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groupCalls/$(groupCallId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.auth.uid in get(/databases/$(database)/documents/groupCalls/$(groupCallId)).data.memberIds;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // peerLinks/{pairId}: 参加者2人ぶんのペア単位のシグナリング。
      // pairId・userAId・userBIdはCallPeerLink.idFor()と同じ規則
      // （辞書順で小さい方がuserA＝オファー役）で組み立てる。
      match /peerLinks/{pairId} {
        allow read: if request.auth != null
          && (resource == null
              || request.auth.uid == resource.data.userAId
              || request.auth.uid == resource.data.userBId);
        allow create: if request.auth != null
          && (request.auth.uid == request.resource.data.userAId
              || request.auth.uid == request.resource.data.userBId);
        allow update: if request.auth != null
          && (request.auth.uid == resource.data.userAId
              || request.auth.uid == resource.data.userBId)
          && request.resource.data.userAId == resource.data.userAId
          && request.resource.data.userBId == resource.data.userBId;
        allow delete: if false;

        // ICE candidateのやり取り用サブコレクション。当事者2人のみ読み書き可能
        // （calls/{callId}のcallerCandidates/calleeCandidatesと同じ考え方）。
        match /{candidateCollection}/{candidateId} {
          allow read, create: if request.auth != null
            && candidateCollection in ['candidatesA', 'candidatesB']
            && (request.auth.uid ==
                  get(/databases/$(database)/documents/groupCalls/$(groupCallId)/peerLinks/$(pairId)).data.userAId
                || request.auth.uid ==
                  get(/databases/$(database)/documents/groupCalls/$(groupCallId)/peerLinks/$(pairId)).data.userBId);
          allow update: if false;
          allow delete: if false;
        }
      }
    }
  }
}
