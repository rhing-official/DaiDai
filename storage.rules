rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // profileMaterials/{userId}/...: 蔵（アイコン・背景画像）。
    // 本人のみアップロード・削除可能。閲覧はログイン済みなら誰でも可能
    // （語らい相手にプロフィール画像を見せる必要があるため）。
    match /profileMaterials/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
