rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // profileMaterials/{userId}/...: 蔵（アイコン・背景画像）。
    // 本人のみアップロード・削除可能。閲覧はログイン済みなら誰でも可能
    // （語らい相手にプロフィール画像を見せる必要があるため）。便り
    // （official-tayori、Firebase Authの実アカウントを持たない）だけは
    // 例外的に管理者がアップロードできる（管理画面の身だしなみタブから、
    // firestore.rulesのisAdmin()と同じ考え方で対象をこのuidのみに限定、
    // 2026-08-12追加）。
    match /profileMaterials/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (request.auth.uid == userId
            || (userId == 'official-tayori' && request.auth.token.admin == true));
    }

    // groupIcons/{groupId}/...: 広場のプロフィールカード用アイコン（2026-07-24追加）。
    // 対応する広場のメンバーのみアップロード可能。閲覧はログイン済みなら誰でも可能
    // （語らい相手・招待リンクを開いた相手にも見せる必要があるため）。
    match /groupIcons/{groupId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds;
    }

    // groupBackgrounds/{groupId}/...: 広場のプロフィールカード用背景画像
    // （2026-07-25追加、個人の工房カードのデザインに合わせるため）。
    // groupIconsと同じ権限（対応する広場のメンバーのみ書き込み、閲覧はログイン済みなら誰でも可能）。
    match /groupBackgrounds/{groupId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds;
    }

    // dmFiles/{dmId}/...: 一対で送信されたファイル・画像・動画の添付
    // （2026-08-10追加、技術仕様書5.2参照）。参加者2人のみアップロード・
    // 閲覧可能（語らい相手以外には見せない）。
    match /dmFiles/{dmId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/directMessages/$(dmId)).data.participants;
    }

    // groupFiles/{groupId}/...: 広場で送信されたファイル・画像・動画の添付
    // （2026-08-10追加、技術仕様書5.2参照）。対応する広場のメンバーのみ
    // アップロード・閲覧可能。
    match /groupFiles/{groupId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds;
    }

    // albumFiles/dm/{dmId}/...、albumFiles/group/{groupId}/...: 寄合単位の
    // 共有アルバムに登録された画像・動画（2026-08-30追加）。元メッセージの
    // dmFiles/groupFilesとは衝突しない別prefixに独立コピーして保存する
    // （「削除するまで半永久保存」の要件のため、元メッセージの寿命から
    // 切り離す設計、lib/utils/album_storage.dart参照）。dmFiles/groupFilesと
    // 同じ粒度（会話全体のメンバーシップのみ）で判定し、寄合単位の絞り込みは
    // firestore.rules側のalbums/itemsドキュメントに任せる。
    match /albumFiles/dm/{dmId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/directMessages/$(dmId)).data.participants;
    }
    match /albumFiles/group/{groupId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds;
    }

    // stickerPackAssets/{creatorId}/...: daidai横丁に出品するペタピタの
    // 画像素材（技術仕様書7.4・7.5参照、2026-08-11追加）。商品画像として
    // 未ログインの一般訪問者にも見せる必要があるため閲覧は誰でも可能。
    // アップロードは本人（creatorId）のみ。
    match /stickerPackAssets/{creatorId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == creatorId;
    }

    // daidaiYokochoProfile/{userId}/...: daidai横丁専用のプロフィールアイコン
    // （2026-08-16追加）。DaiDai本体の身だしなみ（profileMaterials）とは独立した
    // 任意設定のため、あえて別パスにする。未ログインの一般訪問者にもクリエイター
    // アイコンとして見せる必要があるため閲覧は誰でも可能。アップロードは本人のみ。
    match /daidaiYokochoProfile/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
