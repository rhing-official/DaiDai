rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // profileMaterials/{userId}/...: 蔵（アイコン・背景画像）。
    // 本人のみアップロード・削除可能。閲覧はログイン済みなら誰でも可能
    // （語らい相手にプロフィール画像を見せる必要があるため）。
    match /profileMaterials/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // groupIcons/{groupId}/...: 広場のプロフィールカード用アイコン（2026-07-24追加）。
    // 対応する広場のメンバーのみアップロード可能。閲覧はログイン済みなら誰でも可能
    // （語らい相手・招待リンクを開いた相手にも見せる必要があるため）。
    match /groupIcons/{groupId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds;
    }

    // groupBackgrounds/{groupId}/...: 広場のプロフィールカード用背景画像
    // （2026-07-25追加、個人の工房カードのデザインに合わせるため）。
    // groupIconsと同じ権限（対応する広場のメンバーのみ書き込み、閲覧はログイン済みなら誰でも可能）。
    match /groupBackgrounds/{groupId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds;
    }
  }
}
