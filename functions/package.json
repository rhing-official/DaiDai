{
  "name": "daidai-functions",
  "description": "DaiDai用Cloud Functions（アカウント削除の定期処理など）",
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "fluent-ffmpeg": "^2.1.3",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "typescript": "^7.0.2"
  },
  "private": true
}
