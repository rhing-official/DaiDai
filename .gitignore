# Obsidianノートへのシンボリックリンク（個人環境の絶対パス依存のためgit管理外）
/docs/

# 一時的にダウンロードしたFirebase CLIスタンドアロンバイナリ（npm版導入により不要、環境依存の大容量バイナリ）
/.tools/

# Dart & Flutter DevToolsのローカル設定
/devtools_options.yaml

# api/配下（package.json）のNode.js依存関係。Vercelのビルド時に
# npm installし直すためコミット不要（package-lock.jsonはリポジトリに無い
# バージョン固定情報のため、必要なら別途検討）。
/node_modules/
/package-lock.json

# functions/（Firebase Cloud Functions）のNode.js依存関係・ビルド出力。
# デプロイ時にnpm install + npm run buildし直すためコミット不要。
functions/node_modules/
functions/lib/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/
